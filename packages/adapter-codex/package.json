{
  "name": "@beauticode/adapter-codex",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node ../../scripts/copy-renderer-assets.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node ../../scripts/test-runner.mjs --test test/**/*.test.js"
  },
  "dependencies": {
    "@beauticode/core": "0.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.1",
    "typescript": "^5.8.0",
    "ws": "^8.21.1"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT"
}
